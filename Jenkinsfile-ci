
pipeline {

    agent {
        label 'weatherapp-agent'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        DOCKERHUB_USER = 'ibrahimgamal10203040'
        DOCKER_CONFIG  = '/home/jenkins/agent/.docker'

        APP_REPO  = 'https://github.com/Ibrahim-Gamal-Ibrahim/automated-weather_app-deployment.git'
        GITOPS_REPO = 'https://github.com/YOUR-USERNAME/YOUR-GITOPS-REPO.git'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // =========================================================
        // 1. CHECKOUT APPLICATION SOURCE
        // =========================================================

        stage('Checkout Application') {
            steps {
                container('git') {
                    git branch: 'main',
                        url: "${APP_REPO}"
                }
            }
        }


        // =========================================================
        // 2. PREPARE DOCKER HUB AUTHENTICATION
        // =========================================================

        stage('Prepare Docker Auth') {
            steps {
                container('buildkit-auth') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )
                    ]) {

                        sh '''
                            echo "Preparing Docker Hub authentication..."

                            mkdir -p "${DOCKER_CONFIG}"

                            AUTH=$(printf "%s:%s" "$DOCKER_USER" "$DOCKER_PASS" \
                                | base64 | tr -d '\\n')

                            cat > "${DOCKER_CONFIG}/config.json" <<EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "$AUTH"
    }
  }
}
EOF
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 3. BUILD ALL IMAGES IN PARALLEL
        // =========================================================

        stage('Build Images') {

            parallel {

                // -------------------------------------------------
                // AUTH
                // -------------------------------------------------

                stage('Build Auth') {
                    steps {
                        container('buildkit-auth') {

                            sh '''
                                echo "Building Auth image..."
                                echo "Image tag: ${IMAGE_TAG}"

                                export DOCKER_CONFIG="${DOCKER_CONFIG}"

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=auth \
                                  --local dockerfile=auth \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-auth:${IMAGE_TAG},push=true
                            '''
                        }
                    }
                }


                // -------------------------------------------------
                // UI
                // -------------------------------------------------

                stage('Build UI') {
                    steps {
                        container('buildkit-ui') {

                            sh '''
                                echo "Building UI image..."
                                echo "Image tag: ${IMAGE_TAG}"

                                export DOCKER_CONFIG="${DOCKER_CONFIG}"

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=ui \
                                  --local dockerfile=ui \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-ui:${IMAGE_TAG},push=true
                            '''
                        }
                    }
                }


                // -------------------------------------------------
                // WEATHER
                // -------------------------------------------------

                stage('Build Weather') {
                    steps {
                        container('buildkit-weather') {

                            sh '''
                                echo "Building Weather image..."
                                echo "Image tag: ${IMAGE_TAG}"

                                export DOCKER_CONFIG="${DOCKER_CONFIG}"

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=weather \
                                  --local dockerfile=weather \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-weather:${IMAGE_TAG},push=true
                            '''
                        }
                    }
                }
            }
        }


        // =========================================================
        // 4. UPDATE GITOPS REPOSITORY
        // =========================================================

        stage('Update GitOps Repository') {

            steps {

                container('git') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'gitops-repo-credentials',
                            usernameVariable: 'GIT_USERNAME',
                            passwordVariable: 'GIT_PASSWORD'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "=========================================="
                            echo "Updating GitOps repository"
                            echo "Image tag: ${IMAGE_TAG}"
                            echo "=========================================="

                            rm -rf gitops

                            git clone \
                              https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/YOUR-USERNAME/YOUR-GITOPS-REPO.git \
                              gitops

                            cd gitops

                            echo "Current GitOps commit:"
                            git log -1 --oneline

                            # -------------------------------------------------
                            # Update Auth image
                            # -------------------------------------------------

                            sed -i -E \
                              "s|^([[:space:]]*image:[[:space:]]*${DOCKERHUB_USER}/weatherapp-auth:).*|\\1${IMAGE_TAG}|" \
                              auth/deployment.yaml


                            # -------------------------------------------------
                            # Update Weather image
                            # -------------------------------------------------

                            sed -i -E \
                              "s|^([[:space:]]*image:[[:space:]]*${DOCKERHUB_USER}/weatherapp-weather:).*|\\1${IMAGE_TAG}|" \
                              weather/deployment.yaml


                            # -------------------------------------------------
                            # Update UI image
                            # -------------------------------------------------

                            sed -i -E \
                              "s|^([[:space:]]*image:[[:space:]]*${DOCKERHUB_USER}/weatherapp-ui:).*|\\1${IMAGE_TAG}|" \
                              ui/deployment.yaml


                            echo ""
                            echo "Updated image references:"
                            grep -R "image: ${DOCKERHUB_USER}/weatherapp-" \
                                auth/deployment.yaml \
                                weather/deployment.yaml \
                                ui/deployment.yaml


                            # -------------------------------------------------
                            # Configure Git identity
                            # -------------------------------------------------

                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"


                            # -------------------------------------------------
                            # Check whether anything changed
                            # -------------------------------------------------

                            if git diff --quiet; then
                                echo "No GitOps changes detected."
                                exit 0
                            fi


                            # -------------------------------------------------
                            # Commit changes
                            # -------------------------------------------------

                            git add \
                                auth/deployment.yaml \
                                weather/deployment.yaml \
                                ui/deployment.yaml

                            git commit \
                                -m "Deploy weatherapp images ${IMAGE_TAG}"


                            # -------------------------------------------------
                            # Push GitOps change
                            # -------------------------------------------------

                            git push origin main

                            echo ""
                            echo "=========================================="
                            echo "GitOps repository updated successfully"
                            echo "Commit:"
                            git log -1 --oneline
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
    }


    // =============================================================
    // PIPELINE RESULT
    // =============================================================

    post {

        success {
            echo '''
================================================
 CI PIPELINE COMPLETED SUCCESSFULLY

 Docker images built and pushed.
 GitOps repository updated.

 Argo CD will detect the Git change
 and deploy the new application version.
================================================
'''
        }

        failure {
            echo '''
================================================
 CI PIPELINE FAILED

 GitOps repository was NOT intentionally
 updated after the failed pipeline stage.
================================================
'''
        }

        always {
            echo "CI pipeline finished. Build: ${BUILD_NUMBER}"
        }
    }
}

